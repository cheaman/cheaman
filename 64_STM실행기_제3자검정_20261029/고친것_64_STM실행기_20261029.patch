+
+
+def _AI까닭(m):
+    """4절 끝 «모델 정한 까닭» — ② 2-5 AI 짚어 보기를 썼을 때만 · AI 의견은 참고 · 처리는 설계자가 누른 것 (10-28 단계 ③)"""
+    a = m.get('AI') or {}
