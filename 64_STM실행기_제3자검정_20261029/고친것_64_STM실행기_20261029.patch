+        if 면:
+            표[n] = 면
+    return 표
+
+
+def 폭들(m, 힘, 면표=None):
+    """→ {'스트럿': {이름: 폭}, '절점': {'n 면': 폭}, '절점면': 면표, '식': {열쇠: 글}} · 형상(피복 · 받침판)이 없으면 빈 것"""
+    형 = m.get('형상') or {}; 점 = m.get('절점') or {}
+    판 = 형.get('받침판') or []
