+        return 줄
+    out = dict(빈, 절점면=면표)
+    사면폭 = {}; 식 = {}
+    for n in 점:
+        줄 = 사재(n); 합 = sum(x[3] for x in 줄) or 1.0
+        정수압 = lb(n) > 0 and not 가로(n)
+        for 이름, s, c, V in 줄:
+            if 정수압:
+                w = lb(n) * abs(힘[이름]) / 합      # 합 = 판 힘 (사재 연직 힘 합)
+                식[(n, 이름)] = '정수압 절점 : lb × F / P = %.0f × %.1f / %.1f = %.0f mm' % (lb(n), abs(힘[이름]), 합, w)
+            else:
+                l = lb(n) * V / 합; w = l * s + wt(n) * c
