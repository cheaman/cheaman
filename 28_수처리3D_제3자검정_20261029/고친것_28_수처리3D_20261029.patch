+def 바깥벽고리(그물, 점):
+    """바깥벽(외부벽체) 묶음마다 «어느 축을 보나 · 어디에 서 있나 · 어디부터 어디까지» 를 모읍니다
+
+    돌려주는 것 : [{'축': 'X'|'Y', '자리': c, '가로': (lo, hi), '높이': (z0, z1)}]
+    """
+    모음 = {}
+    for p in 그물.get('판요소') or []:
+        if p.get('무엇') != '벽' or p.get('구분') != '외부':
+            continue
+        축 = 벽이보는축(점, p)
+        if 축 is None:
+            continue
+        번호들 = [int(v) for v in (p.get('절점') or [])]
+        xs = [float(점[b]['X']) for b in 번호들 if b in 점]
+        ys = [float(점[b]['Y']) for b in 번호들 if b in 점]
+        zs = [float(점[b]['Z']) for b in 번호들 if b in 점]
+        자리 = round(xs[0] if 축 == 'X' else ys[0], 4)
+        가로 = ys if 축 == 'X' else xs
+        열쇠 = (p.get('묶음') or p.get('벽번호'), 축, 자리)
+        m = 모음.setdefault(열쇠, {'축': 축, '자리': 자리,
+                                  '가로': [min(가로), max(가로)], '높이': [min(zs), max(zs)]})
+        m['가로'][0] = min(m['가로'][0], min(가로)); m['가로'][1] = max(m['가로'][1], max(가로))
+        m['높이'][0] = min(m['높이'][0], min(zs)); m['높이'][1] = max(m['높이'][1], max(zs))
