+    ★ 두 저항은 함께 작용하므로 SDx · SDy · SDz (· SRx …) 를 더합니다. 합친 줄의 꼬리는 «넓이 쓰기 0» (강성 값 그대로)
+    """
+    # 논리줄(«\» 이음 묶음) 읽기 — LINEAR 줄만 [처음 자리, 끝 자리, 절점들, 칸들]
+    항목 = []
+    i = 0
+    while i < len(ㄱ):
+        j = i
+        while j < len(ㄱ) - 1 and ㄱ[j].rstrip().endswith("\\"):
+            j += 1
+        글 = " ".join(s.strip().rstrip("\\").strip() for s in ㄱ[i:j + 1])
+        if 글 and not 글.startswith(";") and not 글.startswith("*") and "," in 글:
