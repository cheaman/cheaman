+def 지속짝(조합=None):
+    """활하중이 없는 사용 조합 이름 (MCT 꼴 'SCase1' …) — 부재력 집계가 SusCase 와 함께 «지속» 으로 봅니다
+    ★ 10-08 틀마다 다름 — 옛 : SCase 1 · 11 ~ 14 / 표준 : SCase 1 · 7 · 8 (조합을 안 주면 옛 틀)"""
+    return [_조합이름(이름) for 이름, 값들 in (조합 or 하중조합들)
+            if 이름.startswith('SCase') and not any(k == '활하중' for k, _ in 값들)]
