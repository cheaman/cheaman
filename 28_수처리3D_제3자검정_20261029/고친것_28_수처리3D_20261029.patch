+            칸 = [x.strip() for x in 뒤.split(",")]
+            if 칸 and 칸[0].upper() == "LINEAR" and len(칸) > 20:
+                절점 = []
+                for t in 앞.split():
+                    if "to" in t:
+                        a, b = t.split("to")[:2]
+                        절점 += list(range(int(a), int(b.split("by")[0]) + 1))
+                    elif t.isdigit():
+                        절점.append(int(t))
+                항목.append([i, j, 절점, 칸])
+        i = j + 1
+    셈 = {}
+    for _, _, 절점, 칸 in 항목:
+        for n in 절점:
+            셈[(n, 칸[20])] = 셈.get((n, 칸[20]), 0) + 1
+    겹 = {k for k, v in 셈.items() if v > 1}
+    if not 겹:
+        return ㄱ, 0
+    합 = {}
+    for _, _, 절점, 칸 in 항목:
+        for n in 절점:
+            if (n, 칸[20]) in 겹:
+                옛 = 합.setdefault((n, 칸[20]), [0.0] * 6)
+                for k in range(6):
