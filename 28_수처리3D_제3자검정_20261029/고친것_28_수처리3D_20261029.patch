+    _무리줄(무리, 덧)
+    마지막 = max(끝 for _, 끝, _, _ in 항목)
+    낼 = []
+    i = 0
+    while i < len(ㄱ):
+        if i in 바꿈:
+            끝, 새 = 바꿈[i]
+            낼 += 새
+            if 끝 >= 마지막:
+                낼 += 덧
+            i = 끝 + 1
+            continue
+        낼.append(ㄱ[i])
+        if i == 마지막:
+            낼 += 덧
+        i += 1
+    return 낼, len(겹)
