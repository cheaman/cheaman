+def _하중계산모듈():
+    """코드\\하중계산.py — 바깥벽 · 안쪽 부호 · 흙 표면을 토압과 «같은 셈» 으로 쓰려고 빌립니다 (고쳐도 서버를 안 껐다 켜게)"""
+    import importlib
+    여기 = os.path.dirname(os.path.abspath(__file__))
+    if 여기 not in sys.path:
