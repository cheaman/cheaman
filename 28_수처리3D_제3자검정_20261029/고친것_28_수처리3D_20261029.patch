+def 절점분담넓이(자료, 맨아래):
+    """바닥 판요소의 넓이를 네 절점에 1/4 씩 나눠 줍니다
+
+    ★ 왜 (2026-09-29)
+      지반 스프링 강성은 «지반반력계수 Kv(kN/m3) × 그 절점이 맡은 넓이(m2)» 입니다.
+      절점마다 맡은 넓이가 다릅니다 (모서리는 1/4, 가장자리는 1/2, 가운데는 1칸).
+      판요소 넓이를 네 절점에 고르게 나누면 그 몫이 저절로 나옵니다.
+
+    ★ 이것은 «설계 판단» 이 아니라 기하 계산이라 도구가 합니다 (28번 원칙 ③)
+      Kv 값 자체는 전무님이 계산서 「5. 지반반력계수」 에서 내어 넣으십니다
+    """
+    점 = {int(n["번"]): n for n in (자료.get("절점") or [])}
+    넓이 = {}
+    for e in 바닥판들(자료, 맨아래):
+        번호들 = [int(v) for v in (e.get("절점") or [])]
+        if len(번호들) not in (3, 4) or any(b not in 점 for b in 번호들):
+            continue
+        # ★ 09-30 — 평면에 비친 넓이(신발끈 공식) · 3절점 판 · 경사판도 (연직 스프링이 받는 넓이)
+        xs = [float(점[b]["X"]) for b in 번호들]
+        ys = [float(점[b]["Y"]) for b in 번호들]
+        넓 = abs(sum(xs[i] * ys[(i + 1) % len(xs)] - xs[(i + 1) % len(xs)] * ys[i] for i in range(len(xs)))) / 2.0
+        if 넓 <= 0:
+            continue
+        for b in 번호들:
+            넓이[b] = 넓이.get(b, 0.0) + 넓 / len(번호들)
+    return 넓이
+
