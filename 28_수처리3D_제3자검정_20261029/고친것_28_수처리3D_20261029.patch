+def 하중조합블록(설계값=None):
+    """*LOADCOMB - 하중조합 (구조계산서 「9. 하중조합」 에서 그대로 · ★ 10-08 틀 : 표준 54 / 옛 60 · 설계값 «조합틀»)
+
+    ★ 2026-09-29 전무님 지시로 넣었습니다.
+    ★ 2026-09-29 밤 — 줄 꼴을 정답지(9.7.5) 그대로 고쳤습니다
+      옛 : Case 01  , GEN, ACTIVE, 0, 0, 설명
+      새 : NAME=Case1, CONC, STRENGTH, 0, 0, , 0, 0, 0, 1
+           강도설계(Case·ECase) 는 STRENGTH · 사용하중(SCase) 은 SERVICE
+      끝에 정답지처럼 «Factor»(Case 1~14 최대값) · «Service»(SCase 1~14 최대값) 봉투 조합을 둡니다
+    """
+    ㄱ = ["", "*LOADCOMB    ; Combinations",
+          "; NAME=NAME, KIND, ACTIVE, bES, iTYPE, DESC, iSERV-TYPE, nLCOMTYPE, nSEISTYPE, LcomFactor ; line 1",
+          ";      ANAL1, LCNAME1, FACT1, ...                                                         ; from line 2"]
+    조합 = 조합표(설계값)
+    for 이름, 값들 in 조합 + 지속조합표(조합):          # ★ 10-02 지속 조합 SusCase 를 맨 뒤에 (SERVICE)
+        갈래 = 'E' if 이름.startswith('E') else ('S' if 이름.startswith('S') else 'C')
+        활성 = 'SERVICE' if 갈래 == 'S' else 'STRENGTH'
+        ㄱ.append("   NAME=%s, CONC, %s, 0, 0, , 0, 0, 0, 1" % (_조합이름(이름), 활성))
+        # 하중 이름과 계수를 네 쌍씩 끊어 적습니다 (정답지도 네 쌍씩 줄을 바꿉니다)
+        낱 = ["ST, %s, %g" % (k, v) for k, v in 값들]
+        for i in range(0, len(낱), 4):
+            ㄱ.append("        " + ", ".join(낱[i:i + 4]))
+    # 봉투 조합 (iTYPE=1 · 정답지에 있는 것 둘만)
+    for 봉투, 머리, 활성 in (('Factor', 'Case', 'STRENGTH'), ('Service', 'SCase', 'STRENGTH')):
+        속 = [_조합이름(n) for n, _ in 조합
+              if _조합이름(n).startswith(머리) and not _조합이름(n).startswith('SCase' if 머리 == 'Case' else '§')]
+        if not 속:
+            continue
+        ㄱ.append("   NAME=%s, CONC, %s, 0, 1, , 0, 0, 0, 1" % (봉투, 활성))
+        낱 = ["CBC, %s, 1" % n for n in 속]
+        for i in range(0, len(낱), 4):
