+        return None
+    _, _, 젖음, _, _, 열, 행, _, 벽칸 = 층
+    if not (0 <= i < 열 and 0 <= j < 행):
+        return True
+    if 벽칸[j][i]:
+        return None
+    return 젖음[j][i]
