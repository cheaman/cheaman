+def 상판반두께(그물, 점, 맨위):
+    """맨 위 수평 판 (상부슬래브) 두께의 반 (m) — 판이 없으면 0"""
+    t = [float(p.get('두께') or 0) for p in 그물.get('판요소') or []
+         if (lambda zs: zs and max(zs) - min(zs) < 1e-6 and abs(zs[0] - 맨위) < 1e-6)(
+             [float(점[int(b)]['Z']) for b in (p.get('절점') or []) if int(b) in 점])]
+    return max(t) / 2.0 if t else 0.0
