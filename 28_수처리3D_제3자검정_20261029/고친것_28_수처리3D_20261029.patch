+   파이썬 안에서 :  from 틀_돌려보기 import 그물, 설계값, 면하중, 요약, MCT글
+"""
+import io, json, os, sys, tempfile, copy
+뿌리 = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
