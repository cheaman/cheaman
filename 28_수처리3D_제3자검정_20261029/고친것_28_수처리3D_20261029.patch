+def 경사수평축들(점, 판):
+    """경사판이 흙 · 물에 밀리는 전역 수평 축들 — [(축, 부호, k)]
+       부호 = 판 아래(바깥 · 흙)에서 미는 쪽 = 위 법선의 수평 성분 쪽 · 안(물)에서 미는 쪽은 그 반대
+       k = |법선 성분| — 판 넓이 × k = 그 축에 수직인 면에 비친 넓이 → 값에 k 를 곱해 «투영 넓이» 와 같은 힘 (MCT 는 정답지처럼 bPROJ NO)"""
+    n = 위법선(점, 판)
+    if not n:
+        return []
+    return [(축, 1 if 성분 > 0 else -1, abs(성분)) for 축, 성분 in (('X', n[0]), ('Y', n[1])) if abs(성분) >= 0.05]
