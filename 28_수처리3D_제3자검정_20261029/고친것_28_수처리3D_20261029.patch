+def 하중틀(자료, 번호표=None):
+    """하중 이름·묶음·경계 묶음 → 경계조건 → 케이스별 하중 → 하중조합
+
+    ★ 차례는 정답지 그대로입니다 : *STLDCASE → *SPRING/*CONSTRAINT → *USE-STLD … → *LOADCOMB
+    """
+    ㄱ = []
+    ㄱ += ["", "*BNDR-GROUP    ; Boundary Group", "; NAME, AUTOTYPE"]
+    for 이름 in 경계묶음들:
+        ㄱ.append("   %s, 0" % 이름)
+
+    ㄱ += ["", "*LOAD-GROUP    ; Load Group", "; NAME"]
+    for 이름 in 하중묶음들:
+        ㄱ.append("   %s" % 이름)
+
+    ㄱ += ["", "*STLDCASE    ; Static Load Cases", "; LCNAME, LCTYPE, DESC"]
+    for 이름, 꼴 in 하중이름들:
+        ㄱ.append("   %-18s, %-2s ," % (이름, 꼴))
+
+    # 3D 에서 읽은 «물·흙 높이» 를 주석으로 남깁니다 (하중 넣으실 때 바로 보십니다)
+    높이들 = (자료.get("참고높이") or {})
+    if 높이들:
+        ㄱ += ["", "; -- 3D 도면에서 읽은 높이 (하중을 넣으실 때 보십시오) --"]
+        for 이름 in sorted(높이들):
+            값 = 높이들[이름]
+            ㄱ.append("; %-10s : %s" % (이름, "  .  ".join("%.3f m" % v for v in 값)))
+
+    # 경계조건 → 케이스별 하중(자중 포함) → 하중조합 60
+    ㄱ += 경계블록(자료, 자료.get("경계") or "하부고정", 자료.get("지반스프링"))
