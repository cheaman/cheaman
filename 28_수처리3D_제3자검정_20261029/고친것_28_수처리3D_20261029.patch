+            줄들 = _목록줄(_번호묶기(남))
+            줄들[-1] = 줄들[-1] + ", " + ", ".join(칸)
+            새 = ["   " + 줄들[0]] + ["        " + s_ for s_ in 줄들[1:]]
+        바꿈[처음] = (끝, 새)
+    무리 = {}
+    for (n, 그룹), v in 합.items():
+        꼬리 = (", LINEAR, NO, NO, NO, NO, NO, NO, %g, %g, %g, %g, %g, %g, NO, 0, 0, 0, 0, 0, 0, %s, 0, 0, 0, 0, 0"
+                % (round(v[0], 3), round(v[1], 3), round(v[2], 3), round(v[3], 3), round(v[4], 3), round(v[5], 3), 그룹))
