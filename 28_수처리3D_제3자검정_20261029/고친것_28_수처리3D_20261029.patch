+def 흙윗Z(그물, 점=None, 맨위=None):
+    """토압이 시작하는 «구조물 맨 윗면» (모델 Z) — 계획고 = 이것 + 기준 EL + 토피 (토피 = 최종 성토고)
+
+    ★ 2026-10-16 (1_기록 175) 상판 있음 = 상판 «윗면» (중심 + 두께 / 2) — 아래 10-03 «상판 중심» 을 바꿈
+
+    ★ 2026-10-03 (1_기록 113) 전무님 확정 «상판 있음 = 상판 중심 · 없음 = 벽 윗끝» · 「토피고 결국 최종 성토고」
+      상판 있음 (가장 높은 절점 자리에 수평 판이 있음) → 맨위 (맨 위 판 가운데 = 상판 중심) — 계산서 · 정답지 그대로 · MCT 안 바뀜
+      상판 없음 (벽만 가장 높이 올라감 · 상판 없는 집수정) → 가장 높은 절점 = 벽 윗끝
+        (전에는 벽 맨 위 «요소 가운데» 를 써 벽 윗끝보다 반 요소(템플릿 집수정 0.23 m) 아래부터 토압이 걸렸음)
+    돌려주는 것 : (Z, 상판있나)"""
+    if 점 is None:
+        점 = {int(n['번']): n for n in 그물.get('절점', [])}
+    맨꼭 = 맨판 = None
+    for p in 그물.get('판요소') or []:
+        zs = [float(점[int(b)]['Z']) for b in (p.get('절점') or []) if int(b) in 점]
+        if not zs:
+            continue
+        위 = max(zs)
+        맨꼭 = 위 if 맨꼭 is None else max(맨꼭, 위)
+        if 위 - min(zs) < 1e-6:                              # 수평 판
+            맨판 = 위 if 맨판 is None else max(맨판, 위)
+    if 맨위 is None:
+        가 = [판가운데(그물, p, 점) for p in 그물.get('판요소') or []]
+        가 = [c for c in 가 if c]
+        맨위 = max(c[2] for c in 가) if 가 else 0.0
+    if 맨꼭 is None or (맨판 is not None and abs(맨판 - 맨꼭) < 1e-6):
+        # ★ 2026-10-16 전무님 확정 (서동혁 차장 의견 8 · 1_기록 175) «흙 표면 = 상판 윗면 + 토피» = 도면 계획고 · 지진 셈과 같은 높이
+        #   (전에는 상판 중심 + 토피 — 표준 계산서 6장 · 반 두께만큼 토압이 작았음)
+        return 맨위 + 상판반두께(그물, 점, 맨위), True
