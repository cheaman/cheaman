+def 판가운데(그물, 판, 점=None):
+    """판요소 네 절점의 가운데 (x, y, z)"""
+    if 점 is None:
+        점 = {int(n['번']): n for n in 그물.get('절점', [])}
+    번호들 = [int(v) for v in (판.get('절점') or [])]
+    if not 번호들:
+        return None
+    xs = [float(점[b]['X']) for b in 번호들 if b in 점]
+    ys = [float(점[b]['Y']) for b in 번호들 if b in 점]
+    zs = [float(점[b]['Z']) for b in 번호들 if b in 점]
+    if not xs:
+        return None
+    return (sum(xs) / len(xs), sum(ys) / len(ys), sum(zs) / len(zs))
