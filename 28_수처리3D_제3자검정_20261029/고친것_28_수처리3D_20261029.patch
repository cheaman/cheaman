+    #    ① 부재별 : 외부벽체1 · 외부벽체2 · 중간슬래브3 …
+    #       하중을 «그 벽 하나에만» 거실 때 씁니다
+    #    ② 종류별 : 외부벽체 · 내부벽체 · 벽체 · 슬래브 · 기둥 · 거더
+    #       전무님 말씀 —「슬래브, 바닥판, 벽체, 내부 벽체, 기둥처럼
+    #       유사한 부분들은 구분해서 그룹으로 묶는다」
+    #       재료·두께를 한꺼번에 보실 때, 해석 뒤 부재력을 «그 종류만» 보실 때 씁니다
+    #    ★ MIDAS 는 한 요소가 여러 그룹에 들어가도 됩니다. 그래서 둘 다 냅니다
+    종류무리 = {}
+
+    def _종류(이름):
+        if 이름.startswith('외부벽체'):
+            return ('외부벽체', '벽체')
+        if 이름.startswith('내부벽체'):
+            return ('내부벽체', '벽체')
+        if 이름.startswith('하부슬래브'):
+            return ('하부슬래브전체', '슬래브')
+        if 이름.startswith('상부슬래브'):
+            return ('상부슬래브전체', '슬래브')
+        if 이름.startswith('중간슬래브'):
+            return ('중간슬래브전체', '슬래브')
+        if 이름.startswith('경사슬래브'):                  # ★ 09-30 경사판 (1_기록 33)
+            return ('슬래브', )
+        if 이름.startswith('기둥'):
+            return ('기둥', )
+        if 이름.startswith('거더'):
+            return ('거더', )
+        return ()
+
+    for 이름, 번호들 in 무리.items():
+        for 종 in _종류(이름):
+            종류무리.setdefault(종, []).extend(번호들)
+
+    # 부재가 하나뿐이면 종류 그룹이 그것과 «요소가 똑같아» 군더더기입니다 - 뺍니다
+    #   보기 : 상부슬래브가 한 층뿐이면 «상부슬래브전체» 는 «상부슬래브» 와 같습니다
+    있는것 = {이름: set(ㅂ) for 이름, ㅂ in 무리.items()}
+    홀로 = [종 for 종, 번호들 in 종류무리.items()
+            if any(set(번호들) == ㅂ for ㅂ in 있는것.values())]
+    for 종 in 홀로:
+        종류무리.pop(종, None)
+
+    # ── 그룹 ────────────────────────────────────────────────────
+    ㄱ += ["", "*GROUP    ; Group", "; NAME, NODE_LIST, ELEM_LIST, PLANE_TYPE"]
+    ㄱ += ["; (1) 부재별 그룹 - 하중을 그 부재 하나에만 거실 때"]
+    묶어낼 = list(무리.items())
+    if 종류무리:
+        묶어낼 += [('__종류머리__', None)]
+        묶어낼 += sorted(((k, sorted(set(v))) for k, v in 종류무리.items()),
+                         key=lambda kv: kv[0])
+    for 이름, 번호들 in 묶어낼:
+        if 이름 == '__종류머리__':
+            ㄱ.append("; (2) 종류별 묶음 그룹 - 같은 종류를 한꺼번에 보실 때 (2026-09-29)")
+            continue
+        if not 번호들:
+            continue
+        줄들 = _목록줄(_번호묶기(번호들))
+        # ★ PLANE_TYPE(, 0) 은 «마지막 줄» 끝에 붙습니다. 이어지는 줄은 « \» 로 끝납니다
+        #   (정답지 MCT 의 거더 그룹이 그 꼴입니다 — 첫 줄에 붙이면 마이다스가 못 읽습니다)
+        줄들[-1] = 줄들[-1] + ", 0"
+        ㄱ.append("   %-10s, , %s" % (이름, 줄들[0]))
+        for s in 줄들[1:]:
+            ㄱ.append("        " + s)
+
+    # ── 하중 틀 ─────────────────────────────────────────────────
+    #  ★ 2026-09-29 — 하중 «값» 은 넣지 않습니다 (28번 원칙 ① — 해석·설계는 MIDAS).
+    #    넣는 것은 «이름과 묶음» 뿐입니다. 유입분배조 정답지 MCT 에 들어 있던
+    #    바로 그 열여덟 · 넷 · 둘을 그대로 씁니다. 전무님이 MIDAS 에서
+    #    하중 값만 채우시면 되도록 틀을 미리 세워 두는 것입니다
+    ㄱ += 하중틀(자료, 번호표)
+    말 += 자료.pop("_경계알림", [])          # ★ 09-30 지진시 경계 알림 (MCT 생성 뒤 칸 5 초록 알림에)
+
+    ㄱ += ["", "*ENDDATA"]
+
+    말.insert(0, "절점 %d개 · 판요소 %d장 · 빔요소 %d개 · 두께 %s mm"
+             % (len(절점), len(판), len(빔),
+                " · ".join(str(int(round(t * 1000))) for t in 두께들)))
+    return ㄱ, 말
+
+
+def _CP949로만(글):
+    """MCT 는 CP949 입니다 - 못 쓰는 글자를 비슷한 것으로 바꿉니다
+
+    ★ 2026-09-29 - 주석에 「」 · «» · - · * 를 쓰면 마이다스에서 ? 로 깨집니다.
+      사람이 매번 조심하는 대신 여기서 한 번에 거릅니다
+    """
+    바꿀것 = {'\u00ab': '', '\u00bb': '', '\u2014': '-', '\u2605': '*',
+              '\u300c': '', '\u300d': '', '\u2192': '->', '\u2026': '...',
+              '\u00d7': 'x', '\u2265': '>=', '\u2264': '<='}
+    for k, v in 바꿀것.items():
+        글 = 글.replace(k, v)
+    # 그래도 남으면 물음표 대신 빈칸으로 (깨진 글자를 안 내보냅니다)
+    낼 = []
+    for c in 글:
+        try:
+            c.encode('cp949')
+            낼.append(c)
+        except UnicodeEncodeError:
+            낼.append(' ')
+    return ''.join(낼)
+
+
+def 쓰기(json경로, 낼경로=None, 고칠=None):
+    """고칠 = 읽은 그물에 덮어 쓸 값 (파일은 안 고침) — ★ 10-05 «두 경계 큰 값» : {'경계': '하부고정'} 로 짝 MCT (1_기록 116)"""
+    with open(json경로, encoding="utf-8") as f:
+        자료 = json.load(f)
+    if 고칠:
+        자료.update(고칠)
+    줄들, 말 = 글짜기(자료)
+    if 낼경로 is None:
+        밑 = os.path.splitext(os.path.basename(json경로))[0]
+        if 밑.startswith("그물_"):
+            밑 = 밑[len("그물_"):]
+        낼경로 = os.path.join(os.path.dirname(json경로), "3_MCT_" + 밑 + ".mct")
+    # ★ MCT 는 CP949 · 줄 끝은 CRLF 입니다 (절대원칙 ⑨)
+    with open(낼경로, "w", encoding="cp949", errors="replace", newline="\r\n") as f:
+        f.write(_CP949로만("\n".join(줄들) + "\n"))
+    # 되읽어 한글이 멀쩡한지 봅니다
+    with open(낼경로, encoding="cp949", errors="replace") as f:
+        되읽음 = f.read()
+    if "거더" not in 되읽음 and "기둥" not in 되읽음:
+        말.append("[!] 되읽으니 한글 그룹 이름이 안 보입니다 — 글자 코드를 확인하십시오")
+    return 낼경로, 말
+
+
+def 돌리기(argv):
+    print("=" * 62)
+    print("  구조물 모델링 — MCT 쓰기   %s  (고친 날 %s)" % (도구판, 고친날))
+    print("=" * 62)
+    길 = argv[1] if len(argv) > 1 else 최신그물(결과)
+    if not 길 or not os.path.exists(길):
+        print()
+        print("  [!] 그물 자료(그물_*.json)를 못 찾았습니다.")
+        print("      확인 화면 4단계에서 «MCT 만들 자료 내보내기» 를 누르시고,")
+        print("      내려받은 파일을 아래 폴더로 옮겨 주십시오.")
+        print("      %s" % 결과)
+        return 1
+    print("\n  읽는 자료 : %s" % os.path.basename(길))
+    낼, 말 = 쓰기(길)
+    for s in 말:
+        print("     " + s)
+    print("\n  → %s  (%.2f MB)" % (os.path.basename(낼), os.path.getsize(낼) / 1024 / 1024))
+    print("     %s" % os.path.dirname(낼))
+    print("\n  다음 : 마이다스에서 [File] → [Import] → [MIDAS CIVIL MCT File] 로 읽으십시오.")
+    print("=" * 62)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(돌리기(sys.argv))
